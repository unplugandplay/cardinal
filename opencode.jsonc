{
  "$schema": "https://opencode.ai/config.json",
  "skills": [".claude/skills"],
  "instructions": [".claude/rules/*.md"],
  "permissions": [
    { "action": "shell", "resource": "just waive-review*", "effect": "deny" },
    { "action": "edit", "resource": "*claude-review-waived", "effect": "deny" }
  ]
}
