# Model used by the harness (OpenCode). Format: <provider>/<model>.
# The Cardinal adapter reads this file and pins the default model; an explicit
# `opencode run --model …` still wins for that run.
# Credentials are not here: they stay in OpenCode's auth store (`opencode auth`).
#
# Any signed-in provider works with the same model:
#   alibaba-token-plan/deepseek-v4.1-flash-1017
#   deepseek/deepseek-v4-pro
#   mistral/deepseek-v4-1-flash-1017
#   synthetic/hf:deepseek-ai/DeepSeek-V4.1-Flash-1017
#   opencode/deepseek-v4.1-flash-free
#
# After editing this file, reload the adapter: touch
# .opencode/plugins/cardinal/index.ts (hot reload) or `opencode service restart`.
OPENCODE_MODEL=alibaba-token-plan/deepseek-v4.1-flash-1017